{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/pytest:*)",
      "Bash(.venv/Scripts/ruff check:*)",
      "Bash(.venv/Scripts/ruff format:*)",
      "Bash(.venv/Scripts/mypy:*)",
      "Bash(.venv/Scripts/alembic current:*)",
      "Bash(.venv/Scripts/alembic history:*)",
      "Bash(.venv/Scripts/alembic upgrade:*)",
      "Bash(.venv/Scripts/alembic revision:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(npm --prefix apps/web run:*)",
      "Bash(npm --prefix apps/web test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
